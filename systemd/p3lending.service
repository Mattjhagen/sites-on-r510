[Unit]
Description=P3 Lending Protocol Frontend
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse/P3-Lending-Protocol
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=5173

[Install]
WantedBy=multi-user.target

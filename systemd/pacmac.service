[Unit]
Description=PacMac ACP Site
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse/PacMac-ACP
ExecStart=/usr/bin/npm run dev -- --port 3007 --host 0.0.0.0
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3007

[Install]
WantedBy=multi-user.target

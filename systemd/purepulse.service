[Unit]
Description=PurePulse Marketing Site
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse/PurePulse-Marketing
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target

[Unit]
Description=Event Transport Protocol
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse/Event-Transport-Protocol
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3008

[Install]
WantedBy=multi-user.target

[Unit]
Description=Rooted Daily Static Site
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/PurePulse/Rooted-Daily-static-site
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3002

[Install]
WantedBy=multi-user.target
